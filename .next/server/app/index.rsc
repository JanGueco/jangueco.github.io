0:{"P":null,"b":"su0H-aZCXtj3sYbw0dZEJ","p":"","c":["",""],"i":false,"f":[[["",{"children":["(version2)",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/9dae90f238ec9279.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/5b63b23c3210b5d0.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"font-sans __variable_245d8d __variable_97c177 antialiased","children":["$","$2",null,{"fallback":["$","div",null,{"children":"Loading..."}],"children":[["$","$L3",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],[]],"forbidden":"$undefined","unauthorized":"$undefined"}],["$","$L5",null,{}]]}]}]}]]}],{"children":["(version2)",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/ab519d2d17f19f89.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],[["$","$L3",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":"$0:f:0:1:1:props:children:1:props:children:props:children:props:children:0:props:notFound:0:1:props:style","children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":"$0:f:0:1:1:props:children:1:props:children:props:children:props:children:0:props:notFound:0:1:props:children:props:children:1:props:style","children":404}],["$","div",null,{"style":"$0:f:0:1:1:props:children:1:props:children:props:children:props:children:0:props:notFound:0:1:props:children:props:children:2:props:style","children":["$","h2",null,{"style":"$0:f:0:1:1:props:children:1:props:children:props:children:props:children:0:props:notFound:0:1:props:children:props:children:2:props:children:props:style","children":"This page could not be found."}]}]]}]}]],[]],"forbidden":"$undefined","unauthorized":"$undefined"}],["$","aside",null,{"className":"v2-crawl-content","aria-label":"Portfolio full text","children":[["$","h2",null,{"children":"Jan Michael Vincent Gueco"}],["$","p",null,{"children":"Data Engineer & Software Developer"}],["$","p",null,{"children":"Data engineer and software developer with 4+ years building data pipelines, web apps, and deployment workflows. I work mainly in Python, SQL, Laravel, and AWS."}],[["$","p","Ever since I was young, I've been fascin",{"children":"Ever since I was young, I've been fascinated by technology. It all started with playing Game Boy classics, then spending countless hours on Counter-Strike and Warcraft. What began as a love for gaming slowly turned into a curiosity about how computers and software actually work."}],["$","p","I pursued this interest by earning a Bac",{"children":"I pursued this interest by earning a Bachelor's Degree in Computer Engineering, where I studied programming, mathematics, and hardware systems. During university, I participated in competitive programming contests and hackathons, which taught me how to think critically, collaborate under pressure, and find creative solutions to tough problems."}],["$","p","I also experimented with Arduino and Ras",{"children":"I also experimented with Arduino and Raspberry Pi, reinforcing my understanding of how software and hardware connect. Along the way, I explored different operating systems like Linux (trying out distros such as Kali, Ubuntu, and even Arch (which I uninstalled pretty quickly) and MacOS, expanding my perspective on how each system offers a unique environment and workflow."}],["$","p","Before finishing university, I completed",{"children":"Before finishing university, I completed an internship that exposed me to both QA testing and IT support. I learned how to spot issues quickly, communicate effectively with teams, and adapt to different roles."}],["$","p","After graduation, I started my career as",{"children":"After graduation, I started my career as a Software Developer, gaining nearly two years of experience building and maintaining software solutions. Later, I transitioned to Data Engineering at Cambridge University Press & Assessment, where I found a good mix of coding and data-driven problem-solving, and was promoted to Data Engineer in 2025."}],["$","p","Alongside that role, I have delivered in",{"children":"Alongside that role, I have delivered independent full-stack contract work: Laravel and PHP marketing sites, DNS and CDN configuration, Nginx on AWS EC2, and integrations such as GoHighLevel CRM for lead capture."}],["$","p","Outside of work, I'm still that curious ",{"children":"Outside of work, I'm still that curious tinkerer who enjoys exploring new technologies, experimenting with ideas, and continuously learning something new every day."}]],[["$","section","Cambridge University Press & Assessment-Data Engineer",{"children":[["$","h3",null,{"children":["Data Engineer"," at ","Cambridge University Press & Assessment"," (","2025 - Present",")"]}],["$","p",null,{"children":"Promoted from Junior Data Engineer in 2025. I deepen Digital Sustainability delivery with PySpark validation, SQL-first pipeline optimization, and AI-assisted discovery, including a proof-of-concept RAG system and carbon reporting for executives."}],["$","ul",null,{"children":[["$","li","Own Digital Sustainability delivery in an Agile and Scrum environment after promotion to Data Engineer",{"children":"Own Digital Sustainability delivery in an Agile and Scrum environment after promotion to Data Engineer"}],["$","li","Led R&D for a Quick Carbon Calculator using Python for automated API ingestion and Matplotlib visualizations for executive reporting",{"children":"Led R&D for a Quick Carbon Calculator using Python for automated API ingestion and Matplotlib visualizations for executive reporting"}],["$","li","Built data quality gates with PySpark, including automated validation checks for alignment and integrity between raw and transformed datasets",{"children":"Built data quality gates with PySpark, including automated validation checks for alignment and integrity between raw and transformed datasets"}],["$","li","Optimized the Digital Sustainability pipeline by simplifying legacy processes and SQL transformations to improve carbon assessment speed and accuracy",{"children":"Optimized the Digital Sustainability pipeline by simplifying legacy processes and SQL transformations to improve carbon assessment speed and accuracy"}],["$","li","Delivered a proof-of-concept RAG system that ingested Confluence documentation into an AI knowledge base using Python, n8n workflow orchestration, and a React front end",{"children":"Delivered a proof-of-concept RAG system that ingested Confluence documentation into an AI knowledge base using Python, n8n workflow orchestration, and a React front end"}],["$","li","Authored technical methodologies and documentation for scripts and assessment findings to support scalability and team alignment",{"children":"Authored technical methodologies and documentation for scripts and assessment findings to support scalability and team alignment"}],["$","li","Generated carbon assessment reports for platform owners and stakeholders; reviewed code and mentored peers",{"children":"Generated carbon assessment reports for platform owners and stakeholders; reviewed code and mentored peers"}],["$","li","Collaborated across regions and traveled to the UK for presentations, workshops, and conferences",{"children":"Collaborated across regions and traveled to the UK for presentations, workshops, and conferences"}]]}],[["$","p","Quick Carbon Calculator R&D with automated API pipelines and Matplotlib reporting for executives.",{"children":"Quick Carbon Calculator R&D with automated API pipelines and Matplotlib reporting for executives."}],["$","p","RAG proof of concept for Confluence-backed knowledge discovery with React and n8n.",{"children":"RAG proof of concept for Confluence-backed knowledge discovery with React and n8n."}],["$","p","Pipeline and SQL modernization work that improved carbon assessment speed and accuracy.",{"children":"Pipeline and SQL modernization work that improved carbon assessment speed and accuracy."}]]]}],["$","section","Cambridge University Press & Assessment-Junior Data Engineer",{"children":[["$","h3",null,{"children":["Junior Data Engineer"," at ","Cambridge University Press & Assessment"," (","2023 - 2025",")"]}],["$","p",null,{"children":"Supported the Digital Sustainability team through data engineering and analytics: automating pipelines, optimizing ETL, and building scalable solutions for digital carbon assessments, plus early AI and LLM experiments to improve data workflows."}],["$","ul",null,{"children":[["$","li","Participated in weekly stand-ups and sprint planning in an Agile and Scrum setup",{"children":"Participated in weekly stand-ups and sprint planning in an Agile and Scrum setup"}],["$","li","Automated ETL processes in Python and transitioned workloads into SQL-based workflows for scalability",{"children":"Automated ETL processes in Python and transitioned workloads into SQL-based workflows for scalability"}],["$","li","Optimized data workflows to improve performance, reliability, and reduce manual intervention",{"children":"Optimized data workflows to improve performance, reliability, and reduce manual intervention"}],["$","li","Researched methodologies and tools for digital carbon emissions from online and cloud activity",{"children":"Researched methodologies and tools for digital carbon emissions from online and cloud activity"}],["$","li","Created documentation, starter packs, and guides for onboarding and internal knowledge sharing",{"children":"Created documentation, starter packs, and guides for onboarding and internal knowledge sharing"}],["$","li","Generated and presented carbon assessment reports to platform owners and stakeholders",{"children":"Generated and presented carbon assessment reports to platform owners and stakeholders"}],["$","li","Prototyped AI and LLM tools in high-code and low-code environments to improve data and architecture discovery",{"children":"Prototyped AI and LLM tools in high-code and low-code environments to improve data and architecture discovery"}],["$","li","Reviewed code, mentored peers, and helped raise team technical standards",{"children":"Reviewed code, mentored peers, and helped raise team technical standards"}],["$","li","Collaborated cross-functionally across regions and traveled to the UK for project presentations, workshops, and conferences",{"children":"Collaborated cross-functionally across regions and traveled to the UK for project presentations, workshops, and conferences"}]]}],[["$","p","Python automation for AWS usage categorization and carbon calculation, cutting processing from days to minutes.",{"children":"Python automation for AWS usage categorization and carbon calculation, cutting processing from days to minutes."}],["$","p","Automated Google Analytics extraction, categorization, and calculations in Python to reduce manual effort and errors.",{"children":"Automated Google Analytics extraction, categorization, and calculations in Python to reduce manual effort and errors."}],["$","p","Automated webpage assessment tooling with Lighthouse, Playwright, and Chrome DevTools for platform carbon impact analysis.",{"children":"Automated webpage assessment tooling with Lighthouse, Playwright, and Chrome DevTools for platform carbon impact analysis."}],["$","p","Led yearly carbon assessments across data collection, cleaning, analysis, reporting, and stakeholder presentation.",{"children":"Led yearly carbon assessments across data collection, cleaning, analysis, reporting, and stakeholder presentation."}],["$","p","Built the internal Digital Emissions Calculator (DEC Tool) as a simplified view of the full digital product carbon assessment process.",{"children":"Built the internal Digital Emissions Calculator (DEC Tool) as a simplified view of the full digital product carbon assessment process."}],["$","p","Migrated Python-based AWS scripts into SQL warehouse workflows for performance and reliability.",{"children":"Migrated Python-based AWS scripts into SQL warehouse workflows for performance and reliability."}],["$","p","Collaborated on AI-driven workflows using LLM agents integrated with N8N for architect discovery and research.",{"children":"Collaborated on AI-driven workflows using LLM agents integrated with N8N for architect discovery and research."}]]]}],["$","section","Enterprise Management Solutions-Full Stack Developer (Contractual - Independent)",{"children":[["$","h3",null,{"children":["Full Stack Developer (Contractual - Independent)"," at ","Enterprise Management Solutions"," (","2025 - 2026",")"]}],["$","p",null,{"children":"Independent contract work: marketing sites, deployment pipelines, and CRM automation for clients. I handled design through Laravel/PHP development, DNS, deployment, and GoHighLevel workflow automation."}],["$","ul",null,{"children":[["$","li","Built marketing websites with Laravel, PHP, and Blade, using custom HTML, CSS, and JavaScript to match client branding",{"children":"Built marketing websites with Laravel, PHP, and Blade, using custom HTML, CSS, and JavaScript to match client branding"}],["$","li","Set up full deployments: DNS through GoDaddy and Cloudflare, TLS, and Nginx on AWS EC2",{"children":"Set up full deployments: DNS through GoDaddy and Cloudflare, TLS, and Nginx on AWS EC2"}],["$","li","Integrated GoHighLevel (GHL) CRM for lead capture and built third-party workflows including food ordering and financial services connections",{"children":"Integrated GoHighLevel (GHL) CRM for lead capture and built third-party workflows including food ordering and financial services connections"}],["$","li","Built a Python automation tool that provisions GoHighLevel intake calendars and notification workflows for Freedom Health Systems across 17 sub-account locations, replacing manual per-location setup",{"children":"Built a Python automation tool that provisions GoHighLevel intake calendars and notification workflows for Freedom Health Systems across 17 sub-account locations, replacing manual per-location setup"}]]}],[["$","p","Built Laravel marketing sites with custom UI and deployed them on Nginx in EC2.",{"children":"Built Laravel marketing sites with custom UI and deployed them on Nginx in EC2."}],["$","p","Connected GHL CRM and other APIs for lead capture and workflows like food ordering and financial services.",{"children":"Connected GHL CRM and other APIs for lead capture and workflows like food ordering and financial services."}],["$","p","Built a GoHighLevel CRM automation tool for Freedom Health Systems that provisions round-robin intake calendars and notification rules across 17 behavioral health locations from shared templates.",{"children":"Built a GoHighLevel CRM automation tool for Freedom Health Systems that provisions round-robin intake calendars and notification rules across 17 behavioral health locations from shared templates."}]]]}],["$","section","Enterprise Management Solutions-Security & Internal Tooling (Concurrent)",{"children":[["$","h3",null,{"children":["Security & Internal Tooling (Concurrent)"," at ","Enterprise Management Solutions"," (","2025 - 2026",")"]}],["$","p",null,{"children":"The Chief Security Officer asked me to build internal security tooling: AWS vulnerability reporting and a security findings dashboard. The CTO asked for a mail ingestion service (Virtual Mailroom). I did this alongside client contract work, using Cursor, Gemini, and Claude."}],["$","ul",null,{"children":[["$","li","Worked with the Chief Security Officer and CTO on what each needed, then built the tooling. I chose the tech stack and how each solution was implemented",{"children":"Worked with the Chief Security Officer and CTO on what each needed, then built the tooling. I chose the tech stack and how each solution was implemented"}],["$","li","Designed and built a Django + React security findings dashboard that ingests monthly AWS Inspector and Prowler scans and surfaces prioritized remediation actions",{"children":"Designed and built a Django + React security findings dashboard that ingests monthly AWS Inspector and Prowler scans and surfaces prioritized remediation actions"}],["$","li","Built a FastAPI-based Virtual Mailroom service at the CTO's request that automatically captures email attachments via Gmail, stores them in AWS S3, and extracts searchable text using AI-powered OCR",{"children":"Built a FastAPI-based Virtual Mailroom service at the CTO's request that automatically captures email attachments via Gmail, stores them in AWS S3, and extracts searchable text using AI-powered OCR"}],["$","li","Automated a monthly AWS security reporting pipeline (Python, boto3, cron) exporting vulnerability and compliance scan data to S3",{"children":"Automated a monthly AWS security reporting pipeline (Python, boto3, cron) exporting vulnerability and compliance scan data to S3"}],["$","li","Built supporting tools (an AWS security checklist app and a standalone report generator) to track audit runbooks and analyze scan findings for executive reporting",{"children":"Built supporting tools (an AWS security checklist app and a standalone report generator) to track audit runbooks and analyze scan findings for executive reporting"}]]}],[["$","p","Built an internal security findings dashboard (Django + React) that ingests monthly AWS Inspector and Prowler scans, tracks vulnerabilities over time, and surfaces prioritized remediation actions for the security team.",{"children":"Built an internal security findings dashboard (Django + React) that ingests monthly AWS Inspector and Prowler scans, tracks vulnerabilities over time, and surfaces prioritized remediation actions for the security team."}],["$","p","Developed a Virtual Mailroom service (FastAPI) at the CTO's request that automatically captures email attachments via Gmail, stores them in AWS S3, extracts text with AI-powered OCR, and makes them searchable internally.",{"children":"Developed a Virtual Mailroom service (FastAPI) at the CTO's request that automatically captures email attachments via Gmail, stores them in AWS S3, extracts text with AI-powered OCR, and makes them searchable internally."}],["$","p","Automated a monthly AWS security reporting pipeline (Python, boto3, cron) that exports vulnerability and compliance scan data to S3 for downstream analysis.",{"children":"Automated a monthly AWS security reporting pipeline (Python, boto3, cron) that exports vulnerability and compliance scan data to S3 for downstream analysis."}],["$","p","Built an internal AWS security checklist app (329 tracked tasks across 7 runbooks) and a standalone report generator analyzing 1,700+ combined security findings, surfacing patterns like a 556-entry SQL injection cluster.",{"children":"Built an internal AWS security checklist app (329 tracked tasks across 7 runbooks) and a standalone report generator analyzing 1,700+ combined security findings, surfacing patterns like a 556-entry SQL injection cluster."}]]]}],["$","section","Direct Sourcing Solutions-Junior Software Developer / OutSystems Developer",{"children":[["$","h3",null,{"children":["Junior Software Developer / OutSystems Developer"," at ","Direct Sourcing Solutions"," (","2021 - 2023",")"]}],["$","p",null,{"children":"Developed and implemented enterprise-grade OutSystems applications for Coca-Cola and MPTC, handling deployments from development through production and authoring user-facing documentation."}],["$","ul",null,{"children":[["$","li","Built and enhanced enterprise-grade web applications for Coca-Cola and MPTC on the OutSystems platform to meet large-scale client requirements",{"children":"Built and enhanced enterprise-grade web applications for Coca-Cola and MPTC on the OutSystems platform to meet large-scale client requirements"}],["$","li","Ran end-to-end deployment workflows from development to production with troubleshooting and production support",{"children":"Ran end-to-end deployment workflows from development to production with troubleshooting and production support"}],["$","li","Collaborated in Agile teams (daily scrums, sprint commitments) and authored user manuals to make handovers smoother and improve the end-user experience",{"children":"Collaborated in Agile teams (daily scrums, sprint commitments) and authored user manuals to make handovers smoother and improve the end-user experience"}],["$","li","Implemented features, resolved bugs across multiple projects, and participated in code reviews",{"children":"Implemented features, resolved bugs across multiple projects, and participated in code reviews"}],["$","li","Maintained technical documentation for modules and workflows; verified production releases post-deployment",{"children":"Maintained technical documentation for modules and workflows; verified production releases post-deployment"}]]}],[["$","p","Contributed to MPTC’s mobile app, MPT DriveHub, used by millions of drivers for toll payments, balance management, and account monitoring. Responsibilities included implementing new features, fixing production bugs, and enhancing user experience.",{"children":"Contributed to MPTC’s mobile app, MPT DriveHub, used by millions of drivers for toll payments, balance management, and account monitoring. Responsibilities included implementing new features, fixing production bugs, and enhancing user experience."}],["$","p","Collaborated on Coca-Cola’s Distribution Management System (DMS), improving logistics operations by adding new modules, fixing bugs, and optimizing performance for high-volume data handling.",{"children":"Collaborated on Coca-Cola’s Distribution Management System (DMS), improving logistics operations by adding new modules, fixing bugs, and optimizing performance for high-volume data handling."}],["$","p","Assisted in Coca-Cola’s Learning Management System (LMS) project, performing QA testing, unit tests, and writing comprehensive user manuals for training and onboarding materials.",{"children":"Assisted in Coca-Cola’s Learning Management System (LMS) project, performing QA testing, unit tests, and writing comprehensive user manuals for training and onboarding materials."}],["$","p","Developed Coca-Cola's Worker Safety and Compliance Application from the ground up for both web and mobile, ensuring compliance tracking, safety audits, and reporting features shipped on schedule.",{"children":"Developed Coca-Cola's Worker Safety and Compliance Application from the ground up for both web and mobile, ensuring compliance tracking, safety audits, and reporting features shipped on schedule."}]]]}],["$","section","Beepo Inc.-IT Support and QA Intern",{"children":[["$","h3",null,{"children":["IT Support and QA Intern"," at ","Beepo Inc."," (","2019",")"]}],["$","p",null,{"children":"Provided IT support and conducted QA testing for newly developed websites as part of my university internship requirement."}],["$","ul",null,{"children":[["$","li","Checked and monitored website accessibility to ensure uptime and functionality",{"children":"Checked and monitored website accessibility to ensure uptime and functionality"}],["$","li","Compared live websites with their wireframe designs to identify inconsistencies and UI issues",{"children":"Compared live websites with their wireframe designs to identify inconsistencies and UI issues"}],["$","li","Resolved employee support tickets related to faulty devices and software issues",{"children":"Resolved employee support tickets related to faulty devices and software issues"}],["$","li","Reformatted and prepared computers for newly hired employees or reassignment",{"children":"Reformatted and prepared computers for newly hired employees or reassignment"}]]}],"$undefined"]}]],[["$","p","Holy Angel University",{"children":["Bachelor in Computer Engineering",", ","Holy Angel University",", ","2015 - 2020"]}]],[["$","p","Python",{"children":["Python",": ","Extensive experience since university across various domains, including data analysis, API development, scripting, web scraping, and even small game projects."]}],["$","p","JavaScript & TypeScript",{"children":["JavaScript & TypeScript",": ","Used JavaScript professionally in web development projects, and currently deepening expertise in TypeScript to build more maintainable and scalable web applications."]}],["$","p","SQL",{"children":["SQL",": ","Applied in both Software Development and Data Engineering roles: designing schemas, optimizing queries, and managing relational databases for production workloads."]}],["$","p","HTML & CSS",{"children":["HTML & CSS",": ","Hands-on experience crafting basic web interfaces and maintaining a clean front-end structure and styling."]}],["$","p","Amazon Web Services (AWS) & Google Cloud Platform (GCP)",{"children":["Amazon Web Services (AWS) & Google Cloud Platform (GCP)",": ","Experience using cloud services for data storage, processing, and analytics, including workflow automation and resource management."]}],["$","p","Nginx",{"children":["Nginx",": ","Practical experience configuring and deploying Nginx to host and serve personal web applications."]}]],[["$","section","GHL Round Robin Calendar Automation",{"children":[["$","h3",null,{"children":"GHL Round Robin Calendar Automation"}],["$","p",null,{"children":"A Python CLI tool built for Freedom Health Systems that automates GoHighLevel intake calendar setup across agency sub-accounts. It provisions round-robin calendars, staff availability, and notification rules from shared templates instead of manual per-location configuration."}]]}],["$","section","Security Findings Dashboard",{"children":[["$","h3",null,{"children":"Security Findings Dashboard"}],["$","p",null,{"children":"An internal Django + React web application that ingests monthly AWS Inspector and Prowler security scan exports, normalizes findings, and visualizes month-over-month deltas, repo-level vulnerabilities, and prioritized action items for a security team."}]]}],["$","section","Virtual Mailroom",{"children":[["$","h3",null,{"children":"Virtual Mailroom"}],["$","p",null,{"children":"An event-driven FastAPI service that automatically ingests PDF/DOCX email attachments from a monitored Gmail inbox via Pub/Sub, stores them in AWS S3, extracts searchable text using Gemini OCR, and exposes the results through an internal intranet API. The Legal team uses it most for searching and retrieving OCR'd text from incoming mail attachments."}]]}],["$","section","Cybersecurity Exports",{"children":[["$","h3",null,{"children":"Cybersecurity Exports"}],["$","p",null,{"children":"A cron-scheduled pipeline on AWS EC2 that runs monthly security data collection. It exports AWS Inspector2 vulnerability findings and Prowler cloud audit results to S3 as standardized JSON for the dashboard to ingest."}]]}],["$","section","AWS Security Checklist App",{"children":[["$","h3",null,{"children":"AWS Security Checklist App"}],["$","p",null,{"children":"A zero-dependency internal web app for tracking recurring AWS security audit and hardening procedures as interactive, checkable runbooks. Covers Security Hub, Prowler, Inspector, Gitleaks, and S3 archiving workflows."}]]}],["$","section","AWS Security Report Generator",{"children":[["$","h3",null,{"children":"AWS Security Report Generator"}],["$","p",null,{"children":"A set of Python scripts and static HTML dashboards that transform raw AWS Inspector and Prowler scan exports into readable executive summaries and repo-level remediation reports."}]]}],["$","section","GreenConvert",{"children":[["$","h3",null,{"children":"GreenConvert"}],["$","p",null,{"children":"A full-stack image and video converter to WebP and WebM with a dark eco-themed UI and estimates of energy and CO₂ savings from smaller file sizes. FastAPI backend (Pillow, ffmpeg) and a React (Vite) plus Tailwind frontend."}]]}],["$","section","Shapes",{"children":[["$","h3",null,{"children":"Shapes"}],["$","p",null,{"children":"A simple yet challenging game built with Python and Pygame where players control a shape to dodge oncoming obstacles. Later integrated NEAT for AI-driven autonomous gameplay."}]]}],["$","section","Double Pendulum Simulation",{"children":[["$","h3",null,{"children":"Double Pendulum Simulation"}],["$","p",null,{"children":"A physics-based simulation of a double pendulum created using the Processing framework in Python. The setup includes a 'pen' attached to visualize the pendulum’s chaotic motion over time."}]]}],["$","section","Pysort",{"children":[["$","h3",null,{"children":"Pysort"}],["$","p",null,{"children":"A simple automation script that organizes files in a directory into folders based on their file types. It was my first real taste of using Python to simplify daily tasks."}]]}],["$","section","YouTube to MP3 Converter",{"children":[["$","h3",null,{"children":"YouTube to MP3 Converter"}],["$","p",null,{"children":"A desktop application that converts YouTube videos to MP3 using Pytube and PyQt6. The app has a simple graphical interface and handles downloads and file conversions in the background."}]]}],["$","section","Mini Project - REST API Blogsite",{"children":[["$","h3",null,{"children":"Mini Project - REST API Blogsite"}],["$","p",null,{"children":"Originally started as a job interview exercise, later expanded into a complete blogsite with authentication, CRUD features, and token-based security using Django REST Framework."}]]}]],[["$","p","LLMs, RAG, and agentic workflows",{"children":["LLMs, RAG, and agentic workflows"," (","Intermediate","): ","Applying RAG, workflow orchestration (n8n), and AI-assisted tooling in production data and internal apps."]}],["$","p","Full-stack delivery (React, TypeScript, Django, FastAPI)",{"children":["Full-stack delivery (React, TypeScript, Django, FastAPI)"," (","Advanced","): ","Shipping end-to-end apps: REST APIs, React dashboards, OAuth, testing, and EC2/Nginx deployment."]}],["$","p","Cloud security pipelines (AWS, Inspector, Prowler, S3)",{"children":["Cloud security pipelines (AWS, Inspector, Prowler, S3)"," (","Intermediate","): ","Building export pipelines and dashboards for vulnerability findings, IAM practices, and reliable ops."]}],["$","p","Event-driven integrations (Gmail, Pub/Sub, Gemini OCR)",{"children":["Event-driven integrations (Gmail, Pub/Sub, Gemini OCR)"," (","Intermediate","): ","Webhook-driven services with idempotent processing, object storage, and searchable document APIs."]}]],[["$","p","Scientific Computing with Python",{"children":["Scientific Computing with Python",", ","FreeCodeCamp",", ","2022"]}],["$","p","Data Analysis with Python",{"children":["Data Analysis with Python",", ","FreeCodeCamp",", ","2022"]}],["$","p","OutSystems Tradition Web Development(Associate)",{"children":["OutSystems Tradition Web Development(Associate)",", ","OutSystems",", ","2021"]}]],["$","p",null,{"children":["Contact: ","jmv.gueco@gmail.com",", ","github.com/JanGueco",","," ","linkedin.com/in/jan-michael-vincent-gueco-607119198"]}]]}]]]}],{"children":["__PAGE__",["$","$1","c",{"children":[["$","$L6",null,{"Component":"$7","searchParams":{},"params":{},"promises":["$@8","$@9"]}],"$undefined",[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/019a634c770c6a9e.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","$La",null,{"children":["$Lb","$Lc",null]}]]}],{},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","kLcUYXohlXz5LigrNdxsy",{"children":[["$","$Ld",null,{"children":"$Le"}],null]}],["$","$Lf",null,{"children":"$L10"}]]}],false]],"m":"$undefined","G":["$11","$undefined"],"s":false,"S":true}
